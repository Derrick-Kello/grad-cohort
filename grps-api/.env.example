# Environment for staging and production (SEC-10: secrets never live in the repository).
DB_URL=jdbc:postgresql://localhost:5432/grps
DB_USER=grps
DB_PASSWORD=change-me
# RS256 key pair in PEM (PKCS#8 private, X.509 public). Without them the API generates a throwaway pair.
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
STORAGE_DIR=./data/files
STORAGE_SIGNING_KEY=change-me-to-a-long-random-string
WEB_ORIGIN=https://grps.example.edu
FRONTEND_URL=https://grps.example.edu
MAIL_ENABLED=true
MAIL_HOST=smtp.example.edu
MAIL_PORT=25
MAIL_FROM=GRPS <no-reply@example.edu>
VIRUS_SCAN_MODE=clamav
CLAMAV_HOST=localhost
CLAMAV_PORT=3310
SCREENING_PROVIDER=stub
